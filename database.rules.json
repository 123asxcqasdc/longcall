{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        "meta": {
          ".validate": "newData.hasChildren(['createdAt', 'createdBy', 'maxParticipants'])"
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['nick', 'joinedAt'])"
          }
        },
        "signals": {
          "$to": {
            "$message": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['from', 'type', 'at'])"
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "logs": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$report": {
          ".validate": "newData.hasChildren(['v','code','env','peers'])"
        }
      }
    }
  }
}
