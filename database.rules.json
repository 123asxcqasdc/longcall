{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        "meta": {
          ".validate": "newData.hasChildren(['createdAt', 'createdBy', 'maxParticipants'])"
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['nick', 'joinedAt'])"
          }
        },
        "signals": {
          "$to": {
            "$message": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['from', 'type', 'at'])"
            }
          }
        },
        "files": {
          "$file": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['name','size','from','at','parts']) && newData.child('size').val() <= 9437184 && newData.child('name').isString() && newData.child('name').val().length < 200"
          }
        },
        "fileparts": {
          "$file": {
            ".write": "auth != null",
            "$part": {
              ".validate": "newData.isString() && newData.val().length < 200000"
            }
          }
        },
        "chat": {
          "$message": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['from','nick','text','at']) && newData.child('from').val() === auth.uid && newData.child('nick').isString() && newData.child('nick').val().length <= 40 && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500 && newData.child('at').isNumber()"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "logs": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$report": {
          ".validate": "newData.hasChildren(['v','code','env','peers'])"
        }
      }
    }
  }
}
