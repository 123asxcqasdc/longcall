; ============================================================================
;  Мастер установки LongCall 98 в стиле Windows 9x
;
;  Файл подключается electron-builder'ом (build.nsis.include) в самое начало
;  сгенерированного скрипта, поэтому здесь можно задавать MUI-переменные до
;  того, как шаблоны electron-builder вставят свои страницы.
;
;  Картинки мастера (боковая панель 164x314 и шапка 150x57) генерируются
;  tools/make-icons.py и подключаются через nsis.installerSidebar /
;  nsis.installerHeader в package.json — свои MUI_*_BITMAP здесь НЕ
;  определяем, иначе получится повторное !define и сборка упадёт.
; ============================================================================

!include "MUI2.nsh"

; ---------------------------------------------------------------------------
;  Классический вид: системный серый, без крупных современных заголовков
; ---------------------------------------------------------------------------
!define MUI_WELCOMEPAGE_TITLE_3LINES
!define MUI_WELCOMEPAGE_TITLE "Добро пожаловать в мастер установки LongCall 98"
!define MUI_WELCOMEPAGE_TEXT "Мастер установит LongCall 98 — программу для аудиозвонков в оформлении Windows 9x.$\r$\n$\r$\nВ программе до 4 человек в комнате, только звук, аккаунт создаётся локально и без пароля.$\r$\n$\r$\nДля продолжения нажмите «Далее»."

!define MUI_DIRECTORYPAGE_TEXT_TOP "Программа будет установлена в папку, указанную ниже. Чтобы выбрать другую папку, нажмите «Обзор»."
!define MUI_DIRECTORYPAGE_TEXT_DESTINATION "Папка установки"

!define MUI_FINISHPAGE_TITLE "Установка завершена"
!define MUI_FINISHPAGE_TEXT "LongCall 98 установлена на этот компьютер.$\r$\n$\r$\nНажмите «Готово», чтобы закрыть мастер."

; ---------------------------------------------------------------------------
;  Страница приветствия: electron-builder вызывает этот макрос вместо своей
; ---------------------------------------------------------------------------
!macro customWelcomePage
  !insertmacro MUI_PAGE_WELCOME
!macroend

; Заголовок окна мастера electron-builder берёт из своего шаблона
; ($(^SetupCaption) + имя продукта), переопределять его здесь не нужно:
; макрос customHeader вставляется вне секций, где Caption недопустим.
